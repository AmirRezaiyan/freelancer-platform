# Local Docker Compose development only. Do not reuse these values in production.
POSTGRES_DB=freelancer
POSTGRES_USER=freelancer
POSTGRES_PASSWORD=local-only-change-this-password
POSTGRES_PORT=5432
BACKEND_PORT=8001
FRONTEND_PORT=5173
DJANGO_ENV=development
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=local-only-change-this-secret-key-before-any-shared-use
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=False
RATE_LIMIT_CACHE_URL=redis://redis:6379/0
PRIVATE_MEDIA_ROOT=/app/private_media
VITE_API_URL=http://localhost:8001/api
