# Optional direct-Django development only. Compose uses the root .env.example and PostgreSQL.
# Never use these values in production.
DJANGO_ENV=development
SECRET_KEY=development-only-insecure-key-not-for-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_ALLOW_CREDENTIALS=False
DATABASE_URL=sqlite:///db.sqlite3

# Production must provide a unique SECRET_KEY (50+ characters), DEBUG=False,
# explicit ALLOWED_HOSTS, HTTPS CORS_ALLOWED_ORIGINS, and a shared Redis
# RATE_LIMIT_CACHE_URL through its environment. Never use the local Redis URL
# below as a production service configuration.
# RATE_LIMIT_CACHE_URL=redis://localhost:6379/0
# DATABASE_URL=postgresql://user:password@localhost:5432/freelancer
# PRIVATE_MEDIA_ROOT=/srv/freelancer/private-media
